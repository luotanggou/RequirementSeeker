{
  "$defs": {
    "ManifestVideo": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "bilibili"
              }
            },
            "required": [
              "platform"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*(?:[Bb][Ii][Ll][Ii][Bb][Ii][Ll][Ii]\\.[Cc][Oo][Mm]|[Bb]23\\.[Tt][Vv])(?::0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\x00-\\x20\\x7f]*)?(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "douyin"
              }
            },
            "required": [
              "platform"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*(?:[Dd][Oo][Uu][Yy][Ii][Nn]\\.[Cc][Oo][Mm]|[Ii][Ee][Ss][Dd][Oo][Uu][Yy][Ii][Nn]\\.[Cc][Oo][Mm])(?::0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\x00-\\x20\\x7f]*)?(?![\\s\\S])"
              }
            }
          }
        }
      ],
      "properties": {
        "platform": {
          "enum": [
            "bilibili",
            "douyin"
          ],
          "title": "Platform",
          "type": "string"
        },
        "video_key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Video Key",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "direction": {
          "enum": [
            "software_tools",
            "tutorial_workflow",
            "life_services",
            "entertainment_culture",
            "ecommerce_marketing"
          ],
          "title": "Direction",
          "type": "string"
        },
        "comment_scale": {
          "enum": [
            "up_to_200",
            "201_to_2000",
            "over_2000"
          ],
          "title": "Comment Scale",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "video_key",
        "url",
        "direction",
        "comment_scale"
      ],
      "title": "ManifestVideo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "1.0",
      "title": "Manifest Version",
      "type": "string"
    },
    "videos": {
      "items": {
        "$ref": "#/$defs/ManifestVideo"
      },
      "title": "Videos",
      "type": "array"
    },
    "unavailable_platforms": {
      "items": {
        "enum": [
          "bilibili",
          "douyin"
        ],
        "type": "string"
      },
      "title": "Unavailable Platforms",
      "type": "array"
    }
  },
  "required": [
    "manifest_version",
    "videos",
    "unavailable_platforms"
  ],
  "title": "CollectionManifest",
  "type": "object"
}
