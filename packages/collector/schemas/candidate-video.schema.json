{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "const": "bilibili"
          }
        },
        "required": [
          "platform"
        ]
      },
      "then": {
        "properties": {
          "url": {
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*(?:[Bb][Ii][Ll][Ii][Bb][Ii][Ll][Ii]\\.[Cc][Oo][Mm]|[Bb]23\\.[Tt][Vv])(?::0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\x00-\\x20\\x7f]*)?(?![\\s\\S])"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "douyin"
          }
        },
        "required": [
          "platform"
        ]
      },
      "then": {
        "properties": {
          "url": {
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*(?:[Dd][Oo][Uu][Yy][Ii][Nn]\\.[Cc][Oo][Mm]|[Ii][Ee][Ss][Dd][Oo][Uu][Yy][Ii][Nn]\\.[Cc][Oo][Mm])(?::0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\x00-\\x20\\x7f]*)?(?![\\s\\S])"
          }
        }
      }
    },
    {
      "properties": {
        "source_page": {
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?![^/?#]*@)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\x00-\\x20\\x7f]*)?(?![\\s\\S])"
        }
      }
    }
  ],
  "properties": {
    "platform": {
      "enum": [
        "bilibili",
        "douyin"
      ],
      "title": "Platform",
      "type": "string"
    },
    "video_key": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Video Key",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "reported_comment_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reported Comment Count"
    },
    "direction": {
      "enum": [
        "software_tools",
        "tutorial_workflow",
        "life_services",
        "entertainment_culture",
        "ecommerce_marketing"
      ],
      "title": "Direction",
      "type": "string"
    },
    "query": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Query"
    },
    "source_page": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Page",
      "type": "string"
    },
    "source_rank": {
      "exclusiveMinimum": 0,
      "title": "Source Rank",
      "type": "integer"
    },
    "discovered_at": {
      "format": "date-time",
      "title": "Discovered At",
      "type": "string"
    }
  },
  "required": [
    "platform",
    "video_key",
    "url",
    "title",
    "reported_comment_count",
    "direction",
    "query",
    "source_page",
    "source_rank",
    "discovered_at"
  ],
  "title": "CandidateVideo",
  "type": "object"
}
